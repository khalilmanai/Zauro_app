# ==============================================
# ZAURO MARKETPLACE BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and update with your actual values
# ==============================================

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DATABASE_URL="postgresql://username:password@localhost:5432/zauro_db"

# ==============================================
# JWT AUTHENTICATION & SECURITY
# ==============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================================
# SMTP EMAIL SERVICE CONFIGURATION
# ==============================================
# Generic SMTP configuration - works with any SMTP provider
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@yourdomain.com"

# SMTP PROVIDER EXAMPLES:
# Mailtrap (Development): smtp.mailtrap.io:587
# Gmail: smtp.gmail.com:587 (requires app password)
# Outlook: smtp-mail.outlook.com:587
# SendGrid: smtp.sendgrid.net:587
# Custom SMTP: your-smtp-server.com:587

# ==============================================
# LEGACY MAILERSEND (DEPRECATED)
# ==============================================
# MAILERSEND_API_KEY="mlsn.e076fba328c1205c515c312a7c97d8de4bf2ca1af530d7a121c67777c20529c1"
# MAILERSEND_FROM="noreply@yourdomain.com"

# ==============================================
# TWILIO SMS SERVICE
# ==============================================
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ==============================================
# HEDERA HASHGRAPH BLOCKCHAIN
# ==============================================
HEDERA_ACCOUNT_ID="0.0.123456"
HEDERA_PRIVATE_KEY="302e020100300506032b657004220420..."
HEDERA_NETWORK="testnet"
HEDERA_MIRROR_NODE_URL="https://testnet.mirrornode.hedera.com"

# ==============================================
# SUPABASE STORAGE
# ==============================================
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==============================================
# ENCRYPTION & SECURITY
# ==============================================
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# ==============================================
# RATE LIMITING & PERFORMANCE
# ==============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ==============================================
# OTP CONFIGURATION
# ==============================================
OTP_EXPIRES_IN_MINUTES=10
OTP_LENGTH=6

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf"

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
# 1. Copy this file: cp env.example .env
# 2. Update all "your-*" placeholders with actual values
# 3. For MailerSend: Domain must be verified in dashboard
# 4. For Hedera: Use testnet for development, mainnet for production
# 5. For Database: Create PostgreSQL database and update URL
# 6. Run: npm install && npm run build && npm run start:dev

# ==============================================
# PRODUCTION NOTES
# ==============================================
# - Change NODE_ENV to "production"
# - Use strong, unique secrets for JWT keys
# - Use production database URL
# - Verify all domains in MailerSend
# - Use mainnet for Hedera in production
# - Enable SSL/HTTPS
# - Set up proper logging and monitoring
